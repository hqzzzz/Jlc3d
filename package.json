{
  "name": "jlc3d-downloader",
  "version": "1.3.0",
  "description": "嘉立创 3D 模型下载器 + 内置 Chili3D 编辑器 - Electron 版本",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:viewer": "esbuild src/objviewer.entry.mjs --bundle --format=iife --minify --outfile=vendor/objviewer.js",
    "sync:chili3d": "node scripts/sync-chili3d.mjs",
    "build": "npm run build:viewer && npm run sync:chili3d && electron-builder --win --x64 --publish never",
    "build:portable": "npm run build:viewer && npm run sync:chili3d && electron-builder --win portable --publish never",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "keywords": [
    "electron",
    "jlc",
    "3d-model",
    "downloader",
    "step",
    "cad"
  ],
  "author": "Jupiter",
  "license": "AGPL-3.0-only",
  "build": {
    "appId": "com.jupiter.jlc3d",
    "productName": "嘉立创 3D 模型下载器",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "server.js",
      "index.html",
      "styles.css",
      "package.json",
      "vendor/chili3d/**",
      "LICENSE",
      "NOTICE.md"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.exe"
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "esbuild": "^0.25.4",
    "three": "^0.160.0"
  }
}
